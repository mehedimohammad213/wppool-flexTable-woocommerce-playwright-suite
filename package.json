{
  "name": "wppool-qa-assignment",
  "version": "1.0.0",
  "description": "Automation Test Suite for FlexTable Plugin and WooCommerce using Playwright with POM",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:flextable": "playwright test tests/flextable/",
    "test:woocommerce": "playwright test tests/woocommerce/",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:ci": "playwright test",
    "generate-pdf": "node generate-pdf-report.js"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "pom",
    "wordpress",
    "woocommerce",
    "flextable"
  ],
  "author": "WPPOOL QA Candidate",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.2"
  }
}
